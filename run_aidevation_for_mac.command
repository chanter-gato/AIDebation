#!/bin/bash

# 1. スクリプトがあるフォルダにカレントディレクトリを移動（cd /d %~dp0 の代わり）
cd "$(dirname "$0")"

echo "==================================================="
echo "⚖️ AIDevation 討論エンジンを起動しています..."
echo "==================================================="
echo ""

# 2. 必要なライブラリがなければ自動でインストール
echo "[システム] ライブラリの依存関係をチェック中..."
pip3 install -q google-genai

echo ""
echo "[システム] 討論を開始します。しばらくお待ちください..."
echo "---------------------------------------------------"
echo ""

# 3. メインプログラムの実行
python3 main.py

echo ""
echo "---------------------------------------------------"
echo "[システム] 討論が終了しました。"

echo "画面を閉じるには何かキーを押してください。"
# 4. キー入力を待つ（pause の代わり）
read -n 1 -s